# Claude evolve-runner image: one of the per-harness images patchy's
# evaluation Jobs run (`evolve exec-unit` + the harness CLI). Used for BOTH
# containers of the ephemeral Job patchy creates:
#
#   initContainer "prepare" — /bin/sh + curl + tar: fetches the
#     digest-verified workspace bundle and stages the unit spec.
#   container "agent"       — runs `evolve exec-unit` (the entrypoint), which
#     execs `claude -p ...` per case and `git` for workspace setup.
#
# The pattern mirrors patchy's Dockerfile.claude-agent-runner: the claude CLI
# is a self-contained native binary, downloaded pinned and checksum-verified
# against the release manifest; the runtime base is Chainguard's wolfi-base.
#
# readOnlyRootFilesystem: patchy runs both containers with a read-only root
# filesystem, uid 65532, all capabilities dropped. The only writable paths
# are /workspace (emptyDir, and HOME) and /tmp; claude keeps its state under
# $HOME, and DISABLE_AUTOUPDATER pins it to the baked version.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669 AS fetch

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates-bundle curl jq

# Pinned claude CLI version; the native binaries release in lockstep with the
# npm package, so the npm datasource stays the source of truth.
# renovate: datasource=npm depName=@anthropic-ai/claude-code
ARG CLAUDE_VERSION=2.1.251

ARG TARGETARCH
# hadolint ignore=DL4006
RUN case "${TARGETARCH}" in \
        amd64) platform=linux-x64 ;; \
        arm64) platform=linux-arm64 ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && base="https://downloads.claude.ai/claude-code-releases" \
    && curl -fsSL -o /tmp/manifest.json "${base}/${CLAUDE_VERSION}/manifest.json" \
    && checksum="$(jq -er ".platforms[\"${platform}\"].checksum" /tmp/manifest.json)" \
    && echo "${checksum}" | grep -qE '^[0-9a-f]{64}$' \
    && curl -fsSL -o /claude "${base}/${CLAUDE_VERSION}/${platform}/claude" \
    && echo "${checksum}  /claude" | sha256sum -c - \
    && chmod 0755 /claude

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669

# curl + tar serve the init container's credential-less bundle fetch; git
# serves per-case workspace initialization and the agent's own commits.
# libgcc + libstdc++ back the dynamically linked claude binary (debian-slim
# shipped them implicitly; wolfi-base does not).
# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates-bundle curl git libgcc libstdc++

COPY --from=fetch /claude /usr/local/bin/claude

# The evolve binary is compiled by GoReleaser and arrives in the build
# context at $TARGETPLATFORM/evolve — no Go toolchain or source here.
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/evolve /usr/local/bin/evolve

# wolfi-base ships the nonroot user (uid/gid 65532), matching patchy's
# runAsUser (the distroless "nonroot" convention) — no useradd needed.

# The native claude binary self-updates by default; an image pins a version
# and runs on a read-only rootfs, so updating must never be attempted.
ENV DISABLE_AUTOUPDATER=1

# HOME is overridden to /workspace by the Job (the only writable dir); this
# is only the sane default for a bare `docker run`.
ENV HOME=/workspace
WORKDIR /workspace

USER 65532:65532
ENTRYPOINT ["evolve"]
