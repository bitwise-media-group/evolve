# Copilot evolve-runner image: one of the per-harness images patchy's
# evaluation Jobs run (`evolve exec-unit` + the harness CLI). See
# Dockerfile.runner-claude for the container contract; this image differs
# only in the CLI it carries. copilot is fetched from the github/copilot-cli
# GitHub release — the official install script's source — whose stable-named
# tarball carries just the entrypoint binary (the npm platform package adds
# optional sibling helpers around the same binary). The digests are pinned
# inline so Renovate bumps each tag + sha pair in lockstep.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:ae9575b121f5776e2f04e192064bc2c5665af9d1c425d620dc773aca31698712 AS fetch

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates-bundle curl

# Each tag + sha256 pair is one Renovate dep (the org preset's release-asset
# manager); the pairs share a release so both arches bump in the same PR. The
# full tag is pinned (not the bare version) because Renovate resolves the
# asset digest by release tag.
# renovate: datasource=github-release-attachments depName=github/copilot-cli
ARG COPILOT_AMD64_RELEASE=v1.0.109
ARG COPILOT_AMD64_SHA256=45a7f37e822e8c8725eda6b27deaed55dad2688ff4163ed27ec22e23293cb761
# renovate: datasource=github-release-attachments depName=github/copilot-cli
ARG COPILOT_ARM64_RELEASE=v1.0.109
ARG COPILOT_ARM64_SHA256=679db06c3168457d8154cd8ce93b822f7c46d3169e61da4c0b78ac6e110c4af6

ARG TARGETARCH
# hadolint ignore=DL4006
RUN case "${TARGETARCH}" in \
        amd64) asset=copilot-linux-x64; tag="${COPILOT_AMD64_RELEASE}"; sha="${COPILOT_AMD64_SHA256}" ;; \
        arm64) asset=copilot-linux-arm64; tag="${COPILOT_ARM64_RELEASE}"; sha="${COPILOT_ARM64_SHA256}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && base="https://github.com/github/copilot-cli/releases/download/${tag}" \
    && curl -fsSL -o /tmp/copilot.tar.gz "${base}/${asset}.tar.gz" \
    && echo "${sha}  /tmp/copilot.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/copilot.tar.gz -C /tmp copilot \
    && mv /tmp/copilot /copilot \
    && rm -f /tmp/copilot.tar.gz \
    && chmod 0755 /copilot

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:ae9575b121f5776e2f04e192064bc2c5665af9d1c425d620dc773aca31698712

# curl + tar serve the init container's credential-less bundle fetch; git
# serves per-case workspace initialization and the agent's own commits.
# libgcc + libstdc++ back the dynamically linked copilot binary (debian-slim
# shipped them implicitly; wolfi-base does not).
# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates-bundle curl git libgcc libstdc++

COPY --from=fetch /copilot /usr/local/bin/copilot

# The evolve binary is compiled by GoReleaser and arrives in the build
# context at $TARGETPLATFORM/evolve — no Go toolchain or source here.
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/evolve /usr/local/bin/evolve

# wolfi-base ships the nonroot user (uid/gid 65532), matching patchy's
# runAsUser (the distroless "nonroot" convention) — no useradd needed.

# The CLI self-updates by default outside CI; an image pins a version and
# runs on a read-only rootfs, so updating must never be attempted.
ENV COPILOT_AUTO_UPDATE=false

# HOME is overridden to /workspace by the Job (the only writable dir); this
# is only the sane default for a bare `docker run`. COPILOT_HOME follows HOME.
ENV HOME=/workspace
WORKDIR /workspace

USER 65532:65532
ENTRYPOINT ["evolve"]
