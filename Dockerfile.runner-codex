# Codex evolve-runner image: one of the per-harness images patchy's
# evaluation Jobs run (`evolve exec-unit` + the harness CLI). See
# Dockerfile.runner-claude for the container contract; this image differs
# only in the CLI it carries. codex ships as a self-contained musl-static
# binary published per GitHub release with no checksum manifest, so the
# digests are pinned inline for a reproducible, attributable image.
FROM debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258 AS fetch

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Each tag + sha256 pair is one Renovate dep (the org preset's release-asset
# manager); the pairs share a release so both arches bump in the same PR. The
# full tag is pinned (not the bare version) because Renovate resolves the
# asset digest by release tag.
# renovate: datasource=github-release-attachments depName=openai/codex versioning=regex:^rust-v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
ARG CODEX_AMD64_RELEASE=rust-v0.149.1
ARG CODEX_AMD64_SHA256=e24fb784c7d71140d67afb620f56e9137496cf7f6c9e19217fa3666dcf306278
# renovate: datasource=github-release-attachments depName=openai/codex versioning=regex:^rust-v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
ARG CODEX_ARM64_RELEASE=rust-v0.149.1
ARG CODEX_ARM64_SHA256=14df6802e39a956de994e844b90d51d8254bcc8057b6e66f0f3e3b8f7e2da5b0

ARG TARGETARCH
# hadolint ignore=DL4006
RUN case "${TARGETARCH}" in \
        amd64) triple=x86_64-unknown-linux-musl; tag="${CODEX_AMD64_RELEASE}"; sha="${CODEX_AMD64_SHA256}" ;; \
        arm64) triple=aarch64-unknown-linux-musl; tag="${CODEX_ARM64_RELEASE}"; sha="${CODEX_ARM64_SHA256}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && base="https://github.com/openai/codex/releases/download/${tag}" \
    && curl -fsSL -o /tmp/codex.tar.gz "${base}/codex-${triple}.tar.gz" \
    && echo "${sha}  /tmp/codex.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/codex.tar.gz -C /tmp \
    && mv "/tmp/codex-${triple}" /codex \
    && rm -f /tmp/codex.tar.gz \
    && chmod 0755 /codex

FROM debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258

# curl + tar serve the init container's credential-less bundle fetch; git
# serves per-case workspace initialization and the agent's own commits.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fetch /codex /usr/local/bin/codex

# The evolve binary is compiled by GoReleaser and arrives in the build
# context at $TARGETPLATFORM/evolve — no Go toolchain or source here.
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/evolve /usr/local/bin/evolve

# uid 65532 matches patchy's runAsUser (the distroless "nonroot" convention).
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /sbin/nologin nonroot

# HOME is overridden to /workspace by the Job (the only writable dir); this
# is only the sane default for a bare `docker run`. codex keeps its state
# under $CODEX_HOME, which evolve points into the workspace.
ENV HOME=/workspace
WORKDIR /workspace

USER 65532:65532
ENTRYPOINT ["evolve"]
